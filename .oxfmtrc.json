{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/.wrangler",
    "**/.vite",
    "**/public",
    ".claude",
    "services/www/themes",
    "services/www/static",
    "services/www/content",
    "services/www/layouts",
    "services/www/archetypes",
    "bun.lock"
  ]
}
