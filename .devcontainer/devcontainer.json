// For format details, see https://aka.ms/devcontainer.json
{
  "name": "Local Development",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  // Pull the prebuilt image on the HOST before the build, so "Rebuild Without
  // Cache" always layers on the freshest base. Replaces `pull_policy: always` in
  // docker-compose.yml, which breaks on Linux/WSL2 when `updateRemoteUserUID`
  // builds a local-only image (gatezh/devcontainers#109). `|| exit 0` keeps
  // offline opens working (valid in POSIX sh and Windows cmd.exe).
  // Keep in sync with the image in docker-compose.yml.
  "initializeCommand": "docker pull ghcr.io/gatezh/devcontainers/claude-code:latest || exit 0",
  "init": true,
  "updateRemoteUserUID": true,
  "remoteUser": "node",
  "otherPortsAttributes": { "onAutoForward": "silent" },
  "customizations": {
    "vscode": {
      "extensions": [
        // **AI Agents**
        // Claude Code - AI coding assistant with chat, inline edits, and terminal integration
        "anthropic.claude-code",

        // **Runtime**
        // Bun - Bun runtime support (debugging, lockfile viewer, bundler integration)
        "oven.bun-vscode",

        // **Code Quality**
        // OXC - Fast linter and formatter for JavaScript/TypeScript (Rust-based)
        "oxc.oxc-vscode",

        // **Tailwind**
        // Tailwind CSS IntelliSense - autocomplete, syntax highlighting, linting for Tailwind classes
        "bradlc.vscode-tailwindcss",
        // Tailwind Fold - collapse long Tailwind class strings in the editor for readability
        "stivo.tailwind-fold",

        // **General**
        // YAML - YAML language support (for workflows and docker-compose)
        "redhat.vscode-yaml",
        // Markdown Preview Github Styles - renders Markdown preview with GitHub's CSS
        "bierner.markdown-preview-github-styles",
        // Docker - Dockerfile and Compose syntax, linting, and image management
        "ms-azuretools.vscode-docker",

        // **Spelling**
        // Code Spell Checker - catches typos in code and comments
        "streetsidesoftware.code-spell-checker",

        // **JavaScript / TypeScript**
        // npm IntelliSense - autocomplete npm imports in import statements
        "christian-kohler.npm-intellisense",
        // TypeScript Error Translator - human-readable TS error messages
        "mattpocock.ts-error-translator",

        // **CSS / Colors**
        // Color Info - preview CSS colors on hover
        "bierner.color-info",
        // Colorize - visualize CSS colors inline in the editor
        "kamikillerto.vscode-colorize",

        // **Testing**
        // Playwright - run, debug, and generate Playwright tests from VS Code
        "ms-playwright.playwright",

        // **Hugo** (project-specific)
        // Hugo language support - syntax highlighting for Hugo templates
        "budparr.language-hugo-vscode",
        // Hugo shortcode syntax - syntax highlighting for Hugo shortcodes
        "kaellarkin.hugo-shortcode-syntax"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "fish",
        "terminal.integrated.profiles.linux": {
          "fish": { "path": "fish" },
          "bash": { "path": "bash", "icon": "terminal-bash" }
        },
        // Suppress extension recommendation prompts
        "extensions.ignoreRecommendations": true,
        // ── Formatter settings (customize per project) ──────────────────
        // Change "editor.defaultFormatter" to match your tooling:
        //   Biome: "biomejs.biome"  |  Prettier: "esbenp.prettier-vscode"
        //   OXC:   "oxc.oxc-vscode" |  None: remove these three settings
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit",
          "source.organizeImports": "explicit"
        },
        // Hugo HTML templates use Go template syntax ({{ }}) - disable OXC formatting
        "[html]": {
          "editor.defaultFormatter": null,
          "editor.formatOnSave": false
        },
        // Show workspace folder name in window title
        "window.title": "${localWorkspaceFolderBasename}"
      }
    }
  },
  // Named volumes keep node_modules OFF the host machine and persist across rebuilds.
  // Uses ${localWorkspaceFolderBasename} so default and sandbox variants share volumes.
  "mounts": [
    // ── node_modules isolation (one per workspace) ─────────────────────
    "source=gatezh-com-node-modules-root-${localWorkspaceFolderBasename},target=/workspace/node_modules,type=volume",
    "source=gatezh-com-node-modules-www-${localWorkspaceFolderBasename},target=/workspace/services/www/node_modules,type=volume",
    "source=gatezh-com-node-modules-email-worker-${localWorkspaceFolderBasename},target=/workspace/services/email-worker/node_modules,type=volume",
    // ── Persistent config ──────────────────────────────────────────────
    "source=gatezh-com-claude-config-${localWorkspaceFolderBasename},target=/home/node/.claude,type=volume",
    "source=gatezh-com-fish-data-${localWorkspaceFolderBasename},target=/home/node/.local/share/fish,type=volume"
  ],
  "containerEnv": {
    "TZ": "${localEnv:TZ:America/Edmonton}",
    "DEVCONTAINER": "true",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },
  // sudo chown fixes volume ownership — safety net in case Docker volume population didn't apply.
  // The find command chowns all node_modules volume mount points in one pass.
  // mise install reads .mise.toml and installs project-specific tool versions.
  // Chromium is baked into the image via apt — no `playwright install` step needed.
  // services/www/playwright.config.ts reads PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH.
  "updateContentCommand": "sudo find /workspace -maxdepth 4 -name node_modules -type d -exec chown node {} + && sudo chown -R node /home/node/.claude && mise install && bun install",
  // One-time setup: register Claude Code marketplaces, install plugins, seed rtk.
  "postCreateCommand": "bash .devcontainer/init-plugins.sh",
  // Re-patch the Playwright MCP plugin's .mcp.json on every start. Defense in
  // depth alongside the SessionStart hook in /etc/claude-code/managed-settings.json,
  // which handles the case where the plugin auto-updates mid-container-run.
  // See gatezh/devcontainers#85, #87, #98.
  "postStartCommand": "/usr/local/bin/patch-playwright-mcp",
  "waitFor": "postCreateCommand"
}
