{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deployed Worker name, deliberately still "email-worker" while the directory
  // is services/api. Renaming this orphans the live Worker and breaks the
  // contact form until production's HUGO_PARAMS_APIURL is repointed, so it
  // happens as the planned rename in docs/deployment.md — not here.
  "name": "gatezh-com-email-worker",
  "main": "src/index.ts",
  // Kept equal to services/www's, and bumped together with it and the wrangler
  // catalog pin — see the note there.
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": true,
    },
  },

  // All runtime configuration comes from the GitHub Environment the deploy job
  // runs in (staging or production) — that is the single source of truth, and
  // nothing here may duplicate it. Values in this file override dashboard and
  // CLI state on every deploy. Local dev reads the repo-root `.env.local`
  // (see services/api/package.json).
  //
  // Secrets (uploaded with the code via `versions upload --secrets-file`, only
  // those set; a deploy never deletes one):
  // - RESEND_API_KEY, TURNSTILE_SECRET_KEY
  // - TO_EMAIL, FROM_EMAIL — secrets rather than vars because Actions logs of
  //   this public repo are world-readable, and a var's value is printed there.
  //
  // Vars (passed with `--var` on the upload):
  // - ALLOWED_ORIGIN (required — the deploy fails without it)

  // Staging only — see the note in services/www/wrangler.jsonc. `vars` is not
  // inherited by an env block, so the empty object is explicit rather than
  // implied: everything arrives from the workflow.
  "env": {
    "staging": {
      "workers_dev": false,
      "routes": [{ "pattern": "staging-api.gatezh.com", "custom_domain": true }],
      "vars": {},
    },
  },
}
