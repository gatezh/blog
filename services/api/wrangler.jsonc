{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deployed Worker name, deliberately still "email-worker" while the directory
  // is services/api. Renaming this orphans the live Worker and breaks the
  // contact form until hugo.yaml's contactWorkerUrl is repointed, so it happens
  // together with the staging/production env blocks and custom-domain routes —
  // not as part of the directory rename.
  "name": "gatezh-com-email-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-03",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Allowed CORS origin for the contact form
    "ALLOWED_ORIGIN": "https://gatezh.com",
  },
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": true,
    },
  },
  // Secrets (set via `wrangler secret put`):
  // - RESEND_API_KEY: Your Resend API key
  // - TURNSTILE_SECRET_KEY: Your Cloudflare Turnstile secret key
  // - TO_EMAIL: Email recipient for contact form submissions
  // - FROM_EMAIL: Email sender (must be from a verified domain in Resend),

  // Staging only — see the note in services/www/wrangler.jsonc. Secrets are
  // supplied per environment by the deploy workflow, not stored here.
  "env": {
    "staging": {
      "workers_dev": false,
      "routes": [{ "pattern": "staging-api.gatezh.com", "custom_domain": true }],
      "vars": { "ALLOWED_ORIGIN": "https://staging.gatezh.com" },
    },
  },
}
