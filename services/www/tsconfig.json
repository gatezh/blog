{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Browser scripts only: the entry points Hugo bundles with js.Build (see
    // themes/terminal/layouts/_partials/js.html). There is no Worker code in
    // this service, so no Workers runtime types.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["assets/js/**/*.ts", "themes/terminal/assets/js/**/*.ts"],
  "exclude": ["node_modules"]
}
