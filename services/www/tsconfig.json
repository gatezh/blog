{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    // Generated by `wrangler types` (chained into the typecheck script). The
    // generated file is gitignored and pinned to this Worker's
    // compatibility_date, which is why it supersedes @cloudflare/workers-types
    // here — that package ships only the latest runtime types.
    // https://developers.cloudflare.com/workers/languages/typescript/#migrating
    "types": ["./worker-configuration.d.ts"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
