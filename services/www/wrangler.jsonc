// Assets only, deliberately no `main`: every request is served by the asset
// store, which is free and unmetered, and never counts against the Workers
// request quota. Response headers (CSP, security headers, X-Robots-Tag) come
// from the public/_headers file Hugo generates
// (layouts/home._outputformat_headers_.txt), and legacy-URL redirects from the
// generated public/_redirects. See docs/adr-005-static-headers-no-worker-code.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gatezh-com",
  // Newest date the pinned wrangler/workerd supports (4.114.0 ships
  // workerd 1.20260722). Raising it past the runtime's own ceiling makes
  // `wrangler dev` refuse to start. Bump together with the wrangler catalog pin.
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    // Unknown paths get public/404.html with a real 404 status. The page itself
    // carries robots noindex.
    "not_found_handling": "404-page",
  },
  "observability": {
    "logs": {
      "enabled": true,
    },
  },

  // Staging only. Production deliberately has NO env block: it keeps deploying
  // under the top-level config and the existing Worker name, so nothing is
  // orphaned and the gatezh.com custom domain does not have to move. Adding a
  // `production` block here renames the deployed Worker — see
  // "Remaining: rename the Workers" in docs/deployment.md before doing that.
  //
  // Staging differs from production only at build time: the deploy builds it
  // with HUGO_ENVIRONMENT=staging, which adds X-Robots-Tag: noindex to _headers.
  "env": {
    "staging": {
      "workers_dev": false,
      "routes": [{ "pattern": "staging-www.gatezh.com", "custom_domain": true }],
    },
  },
}
