{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gatezh-com",
  // Newest date the pinned wrangler/workerd supports (4.114.0 ships
  // workerd 1.20260722). Raising it past the runtime's own ceiling makes
  // `wrangler dev` refuse to start. Bump together with the wrangler catalog pin.
  "compatibility_date": "2026-07-29",
  "main": "src/index.ts",
  "assets": {
    "directory": "./public",
    // Exposes the asset fetcher as `env.ASSETS` in the Worker. Mandatory:
    // without it env.ASSETS is undefined at runtime.
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker has to run before asset matching, or /<slug>/ matches an
    // asset and the handler never sees the request — so no negotiation, no
    // 404 status override and no X-Robots-Tag.
    //
    // Scoped to a route list rather than `true`. Requests to static assets are
    // free and unlimited; requests that reach the Worker script are billed, and
    // on the free plan exhausting that budget returns 429 for the WHOLE SITE
    // instead of falling back to serving assets. With `true`, every stylesheet,
    // font and image spent from that budget for nothing. Negative rules send
    // the hashed-asset directories straight to the asset router.
    // https://developers.cloudflare.com/workers/static-assets/routing/worker-script/
    "run_worker_first": ["/*", "!/css/*", "!/fonts/*", "!/images/*"],
  },
  "observability": {
    "logs": {
      "enabled": true,
    },
  },

  // Staging only. Production deliberately has NO env block: it keeps deploying
  // under the top-level config and the existing Worker name, so nothing is
  // orphaned and the gatezh.com custom domain does not have to move. Adding a
  // `production` block here renames the deployed Worker — see the cutover
  // runbook in docs/deployment.md before doing that.
  "env": {
    "staging": {
      "workers_dev": false,
      "routes": [{ "pattern": "staging.gatezh.com", "custom_domain": true }],
    },
  },
}
