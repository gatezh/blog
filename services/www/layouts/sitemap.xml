{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\" ?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
	{{- /* `where ... "Sitemap.Disable" "ne" true` mirrors Hugo's embedded
	       template. Without it, `sitemap: {disable: true}` front matter — a
	       documented per-page opt-out — silently does nothing. */ -}}
	{{- range where .Pages "Sitemap.Disable" "ne" true -}}
		{{- /* Taxonomy and term listings are excluded: they carry `noindex` (see
		       _partials/head.html), and a sitemap should only advertise URLs we
		       want indexed. */ -}}
		{{- if and .Permalink (not .Params.private) (not (in (slice "taxonomy" "term") .Kind)) -}}
			{{- /* Per-section defaults, overridable per page via `sitemap:` front matter */ -}}
			{{- $priority := "0.5" -}}
			{{- $changefreq := "monthly" -}}
			{{- if .IsHome -}}
				{{- $priority = "1.0" -}}
				{{- $changefreq = "weekly" -}}
			{{- else if eq .Section "posts" -}}
				{{- if eq .Kind "section" -}}
					{{- $priority = "0.8" -}}
					{{- $changefreq = "weekly" -}}
				{{- else -}}
					{{- $priority = "0.7" -}}
				{{- end -}}
			{{- else if eq .Section "ever-learning" -}}
				{{- if eq .Kind "section" -}}
					{{- $priority = "0.6" -}}
					{{- $changefreq = "weekly" -}}
				{{- end -}}
			{{- end -}}
			{{- if ge .Sitemap.Priority 0.0 -}}{{- $priority = .Sitemap.Priority -}}{{- end -}}
			{{- with .Sitemap.ChangeFreq -}}{{- $changefreq = . -}}{{- end -}}
			<url>
				<loc>{{ .Permalink }}</loc>
				{{- if not .Lastmod.IsZero }}
					<lastmod>{{ safeHTML (.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>
				{{- end }}
				<changefreq>{{ $changefreq }}</changefreq>
				<priority>{{ $priority }}</priority>
			</url>
		{{- end -}}
	{{- end }}
</urlset>
