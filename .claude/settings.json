{
  "permissions": {
    "allow": [
      "Bash(bun:*)",
      "Bash(wrangler:*)",
      "Bash(git:*)",
      "Bash(curl:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "EnterWorktree",
      "WorktreeCreate"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "extraKnownMarketplaces": {
    "gatezh": {
      "source": {
        "source": "git",
        "url": "https://github.com/gatezh/claude-skills.git"
      },
      "autoUpdate": true
    },
    "typescript-native-lsp": {
      "source": {
        "source": "github",
        "repo": "rubberduck-studio/typescript-native-lsp"
      }
    }
  },
  "enabledPlugins": {
    "dev@gatezh": true,
    "typescript-native-lsp@typescript-native-lsp": true,
    "typescript-lsp@claude-plugins-official": false
  }
}
