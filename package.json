{
  "name": "gatezh-com-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "services/*"
    ],
    "catalog": {
      "wrangler": "4.114.0",
      "@types/node": "26.1.1"
    }
  },
  "scripts": {
    "dev": "bun --env-file=.env.local run --parallel --filter '*' dev",
    "dev:www": "bun --env-file=.env.local --filter @gatezh/www dev",
    "dev:api": "bun --env-file=.env.local --filter @gatezh/api dev",
    "build": "bun --env-file=.env.local run --parallel --filter '*' build",
    "build:www": "bun --env-file=.env.local --filter @gatezh/www build",
    "build:api": "bun --env-file=.env.local --filter @gatezh/api build",
    "deploy:www": "bun run --cwd services/www deploy",
    "deploy:api": "bun run --cwd services/api deploy",
    "deploy": "bun run deploy:www && bun run deploy:api",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "bunx oxlint",
    "lint:fix": "bunx oxlint --fix",
    "format": "bunx oxfmt .",
    "format:check": "bunx oxfmt --check .",
    "format:hugo": "gotmplfmt -w services/www/themes services/www/layouts",
    "format:hugo:check": "! gotmplfmt -l services/www/themes services/www/layouts | grep .",
    "check": "bun run lint && bun run format:check && bun run format:hugo:check && bun run typecheck && bun run build",
    "outdated": "bun outdated --recursive",
    "test": "bun run test:api && bun run test:www",
    "test:api": "bun run --cwd services/api test",
    "test:www": "bun run --cwd services/www test",
    "test:ui": "bun run --cwd services/www test:ui",
    "test:report": "bun run --cwd services/www test:report"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "catalog:",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "typescript": "7.0.2",
    "wrangler": "catalog:"
  }
}
