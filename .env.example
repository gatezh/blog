# =============================================================================
# Local Development Environment Variables
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Both services — www (Hugo) and email-worker
# (Wrangler) — read this single file at the repository root.
#
# The defaults below are ready to use as-is: they wire the contact form to a
# locally running Worker and use Cloudflare's public Turnstile test keys, which
# always pass. `cp` and `bun run dev` is all you need for the form to work.
#
# ALWAYS start dev servers from the repository root (`bun run dev`,
# `bun run dev:www`, `bun run dev:worker`). `bun --env-file` loads variables into
# bun's own process but does not export them to `bun x` children, so only the
# root scripts propagate this file. Running `bun run dev` from inside
# services/www silently falls back to the production sitekey and Worker URL.
# =============================================================================

# -----------------------------------------------------------------------------
# Dev Server Ports
# -----------------------------------------------------------------------------
# Consumed by the dev scripts as ${WWW_PORT:-1313} / ${WORKER_PORT:-8787}.
# Override these to avoid port conflicts when running multiple template-based
# projects simultaneously. Each project should use unique ports.
#
# Example port ranges for multiple projects:
#   Template:  WWW=1313, Worker=8787
#   Project A: WWW=1401, Worker=8801
#   Project B: WWW=1402, Worker=8802
WWW_PORT=1313
WORKER_PORT=8787

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (Bot Protection)
# -----------------------------------------------------------------------------
# Turnstile gates the contact form against bots. The production keys are
# hostname-scoped in the Cloudflare dashboard, so they do NOT render on
# localhost — that is why local submissions fail without this file.
#
# Cloudflare publishes dummy sitekey/secret pairs for exactly this case. They
# are public, safe to commit, and always pass regardless of the token supplied.
# Docs: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
#
# Other useful pairs while developing:
#   2x00000000000000000000AB / 2x0000000000000000000000000000000AA  always blocks
#   3x00000000000000000000FF / 3x0000000000000000000000000000000AA  forces interactive challenge

# Client-side sitekey, injected into Hugo as .Site.Params.turnstileSiteKey.
# HUGO_PARAMS_* env vars override the value committed in services/www/hugo.yaml,
# so this shadows the production key for local builds only.
HUGO_PARAMS_TURNSTILESITEKEY=1x00000000000000000000AA

# Server-side verification secret, read by the Worker as c.env.TURNSTILE_SECRET_KEY.
# Must be the matching half of the sitekey above — a test token will NOT verify
# against the real production secret.
# Production: set via `wrangler secret put TURNSTILE_SECRET_KEY`.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# -----------------------------------------------------------------------------
# Contact Form Routing
# -----------------------------------------------------------------------------
# Where the Hugo-rendered contact form POSTs. Overrides the deployed Worker URL
# in hugo.yaml so local submissions hit your local `bun run dev:worker` instead
# of production. Keep the port in sync with WORKER_PORT above.
HUGO_PARAMS_CONTACTWORKERURL=http://localhost:8787

# CORS origin the Worker accepts. The Worker already allows any localhost origin
# unconditionally, so this is only needed to mirror production behaviour.
ALLOWED_ORIGIN=http://localhost:1313

# -----------------------------------------------------------------------------
# Resend (Transactional Email) — OPTIONAL for captcha work
# -----------------------------------------------------------------------------
# Only needed if you want a submission to actually deliver an email. Leave the
# API key blank to exercise the Turnstile path alone: the captcha will verify,
# then the Worker returns a 500 at the Resend step. Get a key from
# https://resend.com/api-keys. Production: `wrangler secret put RESEND_API_KEY`.
RESEND_API_KEY=

# Recipient of contact form submissions.
TO_EMAIL=you@example.com

# Sender address — must be on a domain you have verified in Resend.
FROM_EMAIL=noreply@example.com
