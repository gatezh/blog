# =============================================================================
# Unified Local Development Environment Variables
# Copy this file to .env.local and fill in your actual values
# All services (www, api) load from the root .env.local file
# =============================================================================

# -----------------------------------------------------------------------------
# Dev Server Ports
# -----------------------------------------------------------------------------
# Override these to avoid port conflicts when running multiple template-based
# projects simultaneously. Each project should use unique ports.
#
# Example port ranges for multiple projects:
#   Template:  WWW=1313, API=8787
#   Project A: WWW=1401, API=8801
#   Project B: WWW=1402, API=8802
WWW_PORT=1313
API_PORT=8787
# -----------------------------------------------------------------------------
# Contact form Worker (services/api) — every value below is OPTIONAL locally
# -----------------------------------------------------------------------------
# `bun run dev:api` loads this file into the Worker with
# `wrangler dev --env-file`. Deployed environments never read it: staging and
# production take the same names from their GitHub Environment (variables and
# secrets) — see docs/deployment.md.
#
# ALLOWED_ORIGIN is derived from WWW_PORT by services/api/package.json, and
# HUGO_PARAMS_APIURL from API_PORT by services/www/package.json, so neither is
# set here.

# Contact form: POST / returns 503 until all three are set.
# RESEND_API_KEY=re_...
# TO_EMAIL=you@example.com
# FROM_EMAIL=contact@example.com

# Bot gate: set both or neither. These are Cloudflare's always-passing test
# keys, safe to use locally.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# HUGO_PARAMS_TURNSTILESITEKEY=1x00000000000000000000AA
